@startuml arc-05-class-tang-module
!include ../_style.iuml
title Class — Ba tầng bên trong một module server (ví dụ vocab)
hide empty members
class "vocab/routes" as Routes <<routes>> {
  + POST /vocab/lookups
  + POST /vocab/documents
  + POST /vocab/documents/:id/scan
  + GET /vocab/entries
  --
  validate Zod, đăng ký Swagger,
  gọi service, trả JSON
}
class LookupService <<service>> {
  + lookup(userId, input) : { explanation, match, savedEntryId }
}
class ScanService <<service>> {
  + scan(userId, docId, criteria) : Candidate[]
}
class VocabDocumentService <<service>> {
  + createPasted(userId, input) : Document
  + createUploaded(userId, file) : Document
  + createExamDocument(userId, attemptId, passageId) : Document
}
class VocabService <<service>> {
  + saveEntries(userId, items) : VocabEntry[]
  + ... (liệt kê, sửa, xóa từ)
}
class "vocab public API" as PublicApi <<public>> {
  + getEntriesForUser(userId, ids) : VocabEntry[]
  + getDocumentForUser(userId, id) : Document
  + getVocabStats(userId, range) : VocabStats
}
class "core: requireAuth, aiRateLimit,\nvalidate, errorHandler" as MW <<middleware>>
class AiGateway <<core>>
class "PrismaClient" as Prisma <<core>>
class "exam public API" as ExamApi <<public>> {
  + getPassageText(userId, attemptId, passageId)
}
MW --> Routes
Routes --> LookupService
Routes --> ScanService
Routes --> VocabDocumentService
Routes --> VocabService
LookupService --> AiGateway
ScanService --> AiGateway
LookupService --> Prisma
ScanService --> Prisma
VocabService --> Prisma
VocabDocumentService --> Prisma
VocabDocumentService --> ExamApi : chỉ qua public API
PublicApi ..> Prisma
note right of Routes
  Routes không chứa logic nghiệp vụ,
  không truy cập DB trực tiếp.
end note
note right of LookupService
  Service không biết HTTP;
  dễ unit test.
end note
@enduml
