@startuml arc-02-deployment-local
!include ../_style.iuml
title Deployment — Môi trường phát triển (local)
node "Máy lập trình viên" {
  node "Trình duyệt" as B
  node "Node.js — npm run dev" {
    artifact "client (Next.js dev)\n:3000" as C
    artifact "server (Express)\n:4000" as S
  }
  folder "uploads/\n(driver lưu file local)" as UP
  node "Docker" {
    database "Postgres dev\n:5432" as PG
    database "Postgres test" as PGT
  }
}
cloud "Gemini API\n(cần GEMINI_API_KEY; không có thì AI trả 503,\nmock chỉ dùng trong test và e2e)" as AI
node "GitHub Actions (CI)" {
  artifact "job check:\nlint · typecheck · migrate · test · build" as CI
  artifact "job e2e:\nPlaywright, AI giả" as CIE
  database "Postgres service\n(linmaster_test)" as PGCI
  database "Postgres service\n(linmaster_e2e)" as PGE
}
B --> C : HTTP
C --> S : REST /api/v1
S --> PG : Prisma
S --> UP
S --> AI : HTTPS
CI --> PGCI
CIE --> PGE
note bottom of CI
  CI luôn dùng AI mock,
  không gọi Gemini thật.
end note
@enduml
