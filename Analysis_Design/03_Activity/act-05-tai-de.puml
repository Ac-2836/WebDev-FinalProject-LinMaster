@startuml act-05-tai-de
!include ../_style.iuml
title Activity — Tải đề lên (UC30)
|Người học|
start
if (Chọn tab?) then (AI nhận diện)
  repeat
    :Thả thêm file (PDF, audio)
    hoặc bỏ một file;
    |Hệ thống|
    :Lưu file (StoredFile);
    |Gemini AI|
    :classify-pages.v1: gắn nhãn từng trang
    (đề, câu hỏi, đáp án, giải thích,
    transcript, không liên quan)
    + kỹ năng + khoảng số câu;
    |Hệ thống|
    :Audio: đọc độ dài.
    File không nhận ra: đánh dấu Không dùng;
    |Người học|
    :PDF: trình duyệt vẽ từng trang, nhận dạng chữ
    (tesseract.js, hiện "trang x/y"), gửi chữ theo trang
    (PUT /tests/imports/files/{fileId}/text);
    |Hệ thống|
    :Lưu chữ vào StoredFile.pageText;
    :Tính lại bảng Độ đầy đủ
    (buildChecklist, không lưu DB);
    |Người học|
    :Xem bảng Độ đầy đủ;
  repeat while (Còn thiếu thành phần bắt buộc?) is (có)
  ->không;
  :Kiểm tra loại đề tự nhận ra, bấm Tạo đề;
else (Theo mẫu)
  :Chọn loại đề: Reading / Listening / Full;
  :Đặt file vào từng ô: đề, đáp án, audio
  (+ transcript, giải thích nếu có);
  |Hệ thống|
  if (Đủ ô bắt buộc, đúng định dạng,
  đúng dung lượng?) then (không)
    :Báo lỗi ngay trên form;
    stop
  endif
  :Lưu file, gắn nhãn trang;
  |Người học|
  :PDF: trình duyệt nhận dạng chữ từng trang,
  gửi chữ theo trang (PUT …/text);
endif
|Hệ thống|
:Gộp các PDF thành một PDF, kèm chữ OCR
(chỉ khi có nhiều hơn một PDF);
:TestImport = queued, trả importId;
fork
  |Người học|
  :Xem tiến độ xử lý
  (client hỏi trạng thái mỗi vài giây);
fork again
  |Hệ thống|
  :TestImport = parsing;
  |Gemini AI|
  :classify-pages.v1: gắn nhãn lại PDF đã gộp
  (có cache);
  |Hệ thống|
  if (Có trang câu hỏi và trang đáp án?) then (không)
    :TestImport = failed (PAGES_MISSING);
  elseif (Trang đề có chữ OCR?) then (không)
    :TestImport = failed (IMPORT_JOB_FAILED);
  else (có)
    |Gemini AI|
    :parse-test.v3 (chữ OCR các trang đề, câu hỏi)
    → section, nhóm câu, dạng câu, phương án
    + vị trí dòng của bài đọc / transcript;
    |Hệ thống|
    :Cắt bài đọc và transcript từ chữ OCR
    theo vị trí dòng;
    |Gemini AI|
    :parse-answers.v1 (trang đáp án, giải thích)
    → đáp án và giải thích theo số câu,
    tự nhận ra phần Listening / Reading
    (đọc bản PDF, chạy song song với parse-test);
    |Hệ thống|
    if (Part Listening còn trống transcript
    và có audio?) then (có)
      |Gemini AI|
      :parse-audio.v2: nghe audio, viết transcript
      (không có mốc thời gian; lỗi thì bỏ qua);
      |Hệ thống|
      :Thêm cảnh báo TRANSCRIPT_BY_AI;
    endif
    :Ghép transcript vào Passage.paragraphs;
    :TestImport = validating;
    :Ghép đáp án và giải thích
vào Question.answer;
    :Kiểm tra: số câu từng phần theo chứng chỉ,
    đánh số liên tục, đủ đáp án,
    đáp án hợp lệ với dạng câu, audio đọc được;
    if (Có lỗi chặn?) then (không)
      :Ghi Test (riêng tư) và các bảng con;
      :TestImport = done, ghi cảnh báo
      vào errors (severity = warning);
    else (có)
      :TestImport = failed,
      lưu danh sách lỗi theo từng câu;
    endif
  endif
end fork
|Người học|
if (Kết quả?) then (done)
  :Đề xuất hiện trong "Đề của tôi"
  (kèm cảnh báo nếu có);
else (failed)
  :Xem lỗi theo câu, sửa file, tải lại;
endif
stop
@enduml
