@startuml act-08-dung-kho
!include ../_style.iuml
title Activity — Dùng kho cộng đồng: tìm, xem trước, chép, làm đề, báo cáo (UC41–UC45)
|Người học|
start
:Mở /library, chọn tab Bộ thẻ hoặc Đề thi;
:Tìm kiếm, lọc, sắp xếp;
|Hệ thống|
:Trả danh sách nội dung public
(không gồm hidden / private);
|Người học|
:Mở trang xem trước;
|Hệ thống|
if (Loại nội dung?) then (bộ thẻ)
  :Hiện toàn bộ thẻ;
else (đề thi)
  :Hiện kỹ năng, số câu, thời gian,
  dạng câu, người đăng, lượt làm
  (không lộ câu hỏi và đáp án);
endif
|Người học|
switch (Hành động?)
case (Chép bộ thẻ về thư viện)
  |Hệ thống|
  if (Bộ thẻ của chính mình?) then (có)
    :Từ chối 409 OWN_CONTENT;
  elseif (Đã có bản chép?) then (có)
    :Trả bản cũ (200), không tạo bộ mới,
    không tăng copyCount;
  else (chưa)
    :Chép sâu bộ thẻ + thẻ,
    ghi copiedFromId, tăng copyCount (201);
  endif
  :Trang xem trước hiện liên kết
  mở bộ thẻ của người học;
case (Làm đề)
  |Hệ thống|
  :Chuyển sang luồng Làm bài thi (UC32);
  :Khi tạo Attempt (sau các màn trước khi thi)
  attemptCount tăng, chỉ với lượt của người
  không phải chủ đề;
case (Báo cáo)
  |Người học|
  :Chọn lý do, nhập mô tả;
  |Hệ thống|
  if (Nội dung của mình hoặc đã báo cáo rồi?) then (có)
    :Từ chối 409 (OWN_CONTENT hoặc ALREADY_REPORTED);
  else (chưa)
    :Ghi Report;
    if (Đủ 3 báo cáo đang mở?) then (có)
      :visibility = hidden, ẩn khỏi kho;
    endif
  endif
endswitch
stop
@enduml
