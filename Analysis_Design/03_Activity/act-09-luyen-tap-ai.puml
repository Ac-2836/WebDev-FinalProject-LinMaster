@startuml act-09-luyen-tap-ai
!include ../_style.iuml
title Activity — Luyện tập do AI sinh từ bộ thẻ (UC27)
|Người học|
start
:Mở bộ thẻ, chọn "Luyện tập AI";
if (Bộ thẻ có ít nhất 4 thẻ?) then (không)
  :Chế độ bị khóa, gợi ý thêm thẻ;
  stop
endif
:Chọn dạng câu (trắc nghiệm, điền chỗ trống, nối)
và số câu (10 hoặc 20);
:Client mở StudySession (exercise)
ngay khi vào chế độ;
|Hệ thống|
if (Cùng yêu cầu vừa thất bại trong 60 giây?) then (có)
  :Từ chối ngay (chặn lặp lại);
  stop
endif
if (Còn quota AI hôm nay?) then (không)
  :Báo 429 kèm thời điểm được dùng lại;
  stop
endif
if (Có trong AiCache
(bộ thẻ + tham số)?) then (có)
  :Lấy bài từ cache;
else (không)
  |Gemini AI|
  :generate-exercise.v2: soạn câu hỏi
  chỉ dùng thuật ngữ và định nghĩa của bộ thẻ
  (gateway gọi tối đa 3 lần nếu thiếu câu);
  |Hệ thống|
  :Kiểm tra từng câu: đúng schema dạng câu,
  đáp án nằm trong phương án,
  chỉ dùng từ của bộ thẻ;
  :Bỏ câu không đạt;
  if (Còn ít nhất một nửa số câu?) then (không)
    :Báo 502 AI_INVALID_OUTPUT,
    chặn cùng yêu cầu 60 giây;
    stop
  endif
  :Lưu AiCache;
endif
|Người học|
repeat
  :Trả lời câu hỏi
  (component dạng câu của phòng thi);
repeat while (Còn câu?) is (có)
->không;
:Bấm "Chấm";
:Chấm ngay ở client, hiện đúng / sai và đáp án;
:Đóng StudySession;
if (Tiếp tục?) then (tạo bài khác)
  :Bấm "Tạo bài khác": xóa câu hỏi,
  quay lại bước chọn dạng câu;
else (xong)
  :Về trang bộ thẻ;
endif
stop
@enduml
