@startuml act-06-lam-bai-thi
!include ../_style.iuml
title Activity — Làm bài thi CBT (UC32, UC33)
|Người học|
start
:Mở trang đề;
|Hệ thống|
if (Có bài dở của đề này?) then (có)
  :Hiện nút "Tiếp tục" (mở thẳng phòng thi,
  bỏ qua các màn trước khi thi);
else (không)
  :Hiện nút "Bắt đầu";
endif
|Người học|
:Bấm nút;
if (Bấm "Bắt đầu"?) then (đúng)
  :Qua màn xác nhận thông tin, kiểm tra âm thanh
  (đề có audio Listening), hướng dẫn;
endif
|Hệ thống|
:Tạo Attempt (POST /attempts) hoặc mở lại bài dở,
trả serverNow, deadlineAt, state đã lưu;
if (Đã quá hạn?) then (có)
  :Tự nộp với đáp án đã lưu (nộp lười);
else (không)
  |Người học|
  repeat
    :Trả lời, highlight, ghi chú,
    gạch bỏ phương án, đánh dấu câu;
    |Hệ thống|
    :Tự lưu 0,8 giây sau thay đổi cuối
(và khi rời trang);
    if (Lưu được?) then (mất mạng)
      :Hiện "Mất kết nối",
      giữ thay đổi ở trình duyệt,
      thử lại lùi dần (2 s đến 30 s) và khi có mạng;
    else (đã lưu)
    endif
    if (Còn 10 / 5 phút?) then (đúng)
      :Hiện cảnh báo thời gian;
    endif
    |Người học|
  repeat while (Chưa nộp và còn giờ?) is (đúng)
  ->nộp bài hoặc hết giờ;
  if (Hết giờ?) then (có)
    |Hệ thống|
    :Tự nộp, autoSubmitted = true
    (đề Full: hết giờ Listening thì lưu rồi
    chuyển sang Reading, chỉ hết giờ phần cuối mới nộp);
  else (bấm Nộp bài)
    |Người học|
    :Xem số câu chưa làm, xác nhận;
  endif
endif
|Hệ thống|
:Chấm từng câu theo registry dạng câu;
:Ghi AttemptAnswer (chụp đáp án đúng);
:Tính số câu đúng, quy ra band;
:Attempt = submitted;
:Chuyển tới trang kết quả;
stop
@enduml
