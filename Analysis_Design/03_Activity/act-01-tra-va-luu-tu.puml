@startuml act-01-tra-va-luu-tu
!include ../_style.iuml
title Activity — Đọc tài liệu, tra từ và lưu từ (UC10–UC13)
|Người học|
start
:Tạo tài liệu: dán văn bản
hoặc tải file PDF / DOCX / TXT;
|Hệ thống|
while (File sai định dạng, quá 5 MB, quá 20.000 từ hoặc không trích được chữ?) is (có)
  :Báo lỗi cụ thể, giữ nguyên form;
  |Người học|
  :Chọn file khác hoặc dán văn bản;
  |Hệ thống|
endwhile (không)
:Trích chữ, lưu Document;
|Người học|
:Mở tài liệu trong Trình đọc;
|Hệ thống|
:Tải nội dung tài liệu
và các từ đã lưu;
:Hiển thị bài đọc,
tô màu các từ đã lưu;
|Người học|
repeat
  :Bôi chọn từ hoặc cụm từ;
  if (Chọn quá 6 từ?) then (có)
    |Hệ thống|
    :Không nhận vùng chọn,
    hiện thông báo "Chọn tối đa 6 từ";
  else (không)
    |Người học|
    :Bấm "Giải thích" (hoặc phím tắt);
    |Hệ thống|
    :Kiểm tra quota AI trong ngày;
    if (Còn quota?) then (không)
      :Báo hết lượt tra hôm nay;
    else (có)
      if (Có trong AiCache?) then (có)
        :Lấy kết quả từ cache;
      else (không)
        |Gemini AI|
        :Giải thích theo câu chứa từ và
        chủ đề của bài (explain-word.v2);
        |Hệ thống|
        :Kiểm tra kết quả bằng schema
        (thử lại tối đa 2 lần);
      endif
      :Tìm cụm AI giải nghĩa trong câu
      (nguyên văn, chạm vùng chọn, tối đa 6 từ);
      if (Cụm sai hoặc bị rút còn 1 từ?) then (có)
        |Gemini AI|
        :Hỏi lại AI 1 lần, kèm lý do
        (tính thêm một lượt quota);
        |Hệ thống|
      endif
      if (Có kết quả hợp lệ?) then (không)
        :Báo lỗi AI (502 hoặc 503),
        mời thử lại, không trừ quota;
      else (có)
      :Lưu vào AiCache (nếu mới);
      :Ghi VocabLookup;
      :Dời khung đánh dấu theo cụm
      đã giải nghĩa (match);
      :Hiện popover: nghĩa trong câu và chủ đề bài,
      IPA, cách dùng, collocations, CEFR;
      |Người học|
      if (Muốn lưu từ?) then (có)
        :Bấm "Lưu";
        |Hệ thống|
        if (Từ đã có trong kho
        (cùng lemma + loại từ)?) then (có)
          :Thêm câu gốc mới (VocabContext);
        else (chưa)
          :Tạo VocabEntry + VocabContext;
        endif
        :Tô màu từ trong bài;
        :Popover đổi sang "Đã lưu kèm câu này"
        với liên kết "Mở kho từ";
      else (không)
      endif
      endif
    endif
  endif
  |Người học|
repeat while (Đọc tiếp?) is (có)
->không;
stop
@enduml
