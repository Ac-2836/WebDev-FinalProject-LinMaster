@startuml act-07-dang-len-kho
!include ../_style.iuml
title Activity — Đăng lên / gỡ khỏi kho cộng đồng (UC40)
|Chủ sở hữu|
start
:Mở bộ thẻ hoặc đề của mình;
if (Hành động?) then (Đăng lên)
  |Hệ thống|
  if (Nội dung đang bị ẩn do báo cáo?) then (có)
    :Từ chối 409 CONTENT_HIDDEN:
    chủ phải Gỡ xuống trước;
    stop
  endif
  if (Là bộ thẻ và không có thẻ nào?) then (có)
    :Từ chối 422 SET_EMPTY;
    stop
  endif
  if (Là đề và chưa ghi nguồn?) then (có)
    |Chủ sở hữu|
    :Nhập nguồn đề;
  endif
  |Hệ thống|
  :visibility = public, ghi publishedAt
  (giữ lần đăng đầu tiên);
  :Nội dung xuất hiện trong kho;
else (Gỡ xuống)
  |Hệ thống|
  :visibility = private;
  :Nếu đang bị ẩn: các báo cáo đang mở
  chuyển resolved, sau đó đăng lại được;
  :Ẩn khỏi kho; các bản đã chép vẫn giữ;
endif
stop
@enduml
