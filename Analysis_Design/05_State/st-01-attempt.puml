@startuml st-01-attempt
!include ../_style.iuml
title State — Lượt làm bài (Attempt)
[*] --> InProgress : POST /attempts\n[chưa có bài dở, hoặc bài dở đã quá hạn\n(nộp lười bài cũ rồi tạo bài mới)]\n/ startedAt = now, deadlineAt = now + tổng thời gian

state "in_progress" as InProgress {
  state "Listening" as L {
    state "Đang phát audio" as Play
    state "Kiểm tra lại" as Review
    [*] --> Play
    Play --> Review : audio kết thúc\n(phần còn lại của khung giờ Listening)
  }
  state "Reading" as R
  state c <<choice>>
  [*] --> c
  c --> L : [đề Listening hoặc Full]
  c --> R : [đề Reading]
  L --> R : [đề Full] hết khung giờ Listening\n(30 phút + 2 phút kiểm tra lại)
  InProgress : do / tự lưu state 0,8 giây sau thay đổi cuối
  InProgress : entry (mở lại) / khôi phục state, đồng bộ đồng hồ
}

InProgress --> InProgress : PUT /state [now < deadlineAt]\n/ ghi state
InProgress --> Submitted : Người học bấm Nộp bài\n/ chấm, autoSubmitted = false
InProgress --> Submitted : Hết giờ phần cuối (client lưu bài rồi tự gọi nộp)\n/ chấm, autoSubmitted = true
InProgress --> Submitted : Mở lại bài khi đã quá hạn (nộp lười)\n/ chấm với state đã lưu, autoSubmitted = true

state "submitted" as Submitted
Submitted : chỉ đọc; nộp lại trả kết quả cũ
Submitted --> [*]
@enduml
