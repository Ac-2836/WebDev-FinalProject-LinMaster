@startuml seq-08-hoc-the
!include ../_style.iuml
title Sequence — Học thẻ theo SM-2 (UC25)
autonumber
actor "Người học" as U
participant "Màn học\n(Client)" as C
participant "Flashcard route" as R
participant "StudyService" as S
participant "Scheduler SM-2" as SM
database "PostgreSQL" as DB
U -> C : Chọn chế độ "Học"
C -> R : POST /api/v1/flashcards/sessions { setId, mode: learn }
R -> S : startSession
S -> DB : INSERT StudySession
R --> C : 201 { session }
C -> R : GET /api/v1/flashcards/sets/:id/study
R -> S : dueCards(userId, setId, today theo giờ VN)
S -> DB : CardProgress.dueAt < cuối ngày hôm nay (giờ VN)\n+ thẻ chưa có tiến độ (tối đa 20 thẻ mới mỗi ngày)
R --> C : cards[]
loop Mỗi thẻ
  U -> C : Lật thẻ, chấm Good (phím 3)
  C -> R : POST /api/v1/flashcards/reviews\n{ cardId, rating, sessionId }
  R -> S : review
  S -> SM : scheduleReview(previous, rating, now)
  SM --> S : easiness, intervalDays, repetitions, dueAt
  S -> DB : UPSERT CardProgress, INSERT ReviewLog
  R --> C : 200 { progress: CardProgress }
end
C -> R : PATCH /api/v1/flashcards/sessions/:id\n{ cardsStudied?, correctCount? }
R -> S : endSession
S -> DB : UPDATE StudySession (server đặt endedAt;\nphiên Học đếm số thẻ từ ReviewLog)
C --> U : Tổng kết phiên
@enduml
