@startuml seq-06-nop-va-cham
!include ../_style.iuml
title Sequence — Nộp bài và chấm điểm (UC33)
autonumber
actor "Người học" as U
participant "Phòng thi\n(Client)" as C
participant "Attempt route" as R
participant "AttemptService" as S
participant "Question kind\nregistry (shared)" as Q
participant "Certification\nregistry (shared)" as CR
database "PostgreSQL" as DB
alt Người học bấm "Nộp bài"
  U -> C : Xác nhận nộp
else Hết giờ
  C -> C : Đồng hồ về 0 ở phần cuối\nclient lưu bài (flush) rồi tự gọi nộp
end
C -> R : POST /api/v1/attempts/:id/submit
R -> S : submit(userId, attemptId)
S -> DB : Đọc Attempt
alt Đã submitted
  S --> R : kết quả cũ (không chấm lại)
else in_progress
  S -> DB : SELECT các Question + answer của đề
  loop Mỗi nhóm câu
    S -> Q : gradeGroup(kind, items, { wordLimit })
    Q --> S : isCorrect[]
  end
  S -> CR : toBand(certification, skill, correct)
  CR --> S : band
  S -> DB : Trong một transaction: UPDATE Attempt WHERE status = in_progress\n(submitted, submittedAt, autoSubmitted, số câu đúng, band)\n(không có dòng nào: đã nộp bởi lần gọi khác, dừng)
  S -> DB : rồi INSERT AttemptAnswer x 40 / 80\n(chụp correctAnswer)
end
S --> R : AttemptResult
R --> C : 200 { result }
C -> R : reload: GET /api/v1/attempts/:id\n(màn "đã nộp" có liên kết xem kết quả)
C -> R : GET /api/v1/attempts/:id/result\n(trang kết quả)
R --> C : điểm, band, từng câu
C --> U : Trang kết quả
@enduml
