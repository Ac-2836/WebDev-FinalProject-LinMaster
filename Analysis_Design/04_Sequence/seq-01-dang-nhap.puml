@startuml seq-01-dang-nhap
!include ../_style.iuml
title Sequence — Đăng nhập (UC02)
autonumber
actor "Khách" as U
participant "Client\n(Next.js)" as C
participant "Auth route\n(/auth/login)" as R
participant "AuthService" as S
database "PostgreSQL" as DB
U -> C : Nhập email, mật khẩu
C -> R : POST /api/v1/auth/login {email, password}
R -> R : Rate limit đăng nhập (10 lần / 15 phút)\n+ validate Zod
alt Quá số lần thử
  R --> C : 429 RESOURCE_EXHAUSTED
else Hợp lệ
  R -> S : login(email, password)
  S -> DB : SELECT User WHERE email
  DB --> S : user | null
  alt Không có user hoặc bcrypt.compare sai
    S --> R : AppError 401
    R --> C : 401 UNAUTHENTICATED
    C --> U : "Email hoặc mật khẩu không đúng"
  else Đúng
    S -> S : Ký JWT (sub = userId, hết hạn 1 giờ)
    S --> R : { token, user }
    R --> C : 200 { token, user }
    C -> C : Lưu token, đặt ngôn ngữ = user.locale
    C --> U : Chuyển tới next hoặc /home
  end
end
@enduml
