@startuml seq-03-loc-nhanh
!include ../_style.iuml
title Sequence — Lọc nhanh từ trong tài liệu (UC14)
autonumber
actor "Người học" as U
participant "Trình đọc\n(Client)" as C
participant "Vocab route" as R
participant "ScanService" as S
participant "VocabService" as V
participant "AI gateway" as G
database "PostgreSQL" as DB
participant "Gemini API" as AI
U -> C : Chọn CEFR / chủ đề, bấm "Lọc"
C -> R : POST /api/v1/vocab/documents/:id/scan\n{ levels?, topics? } + JWT
R -> R : requireAuth + aiRateLimit\n+ validate Zod
R -> S : scan(userId, documentId, criteria)
S -> DB : SELECT Document (kiểm tra chủ sở hữu)
alt Không phải của người học
  S --> R : NotFound
  R --> C : 404
else Đúng chủ sở hữu
  S -> S : Ghép các đoạn thành một văn bản
  S -> G : runJsonTask("scan-document.v1", { text, criteria })
  alt Hết quota
    G --> S : AiQuotaExceeded
    S --> R : lỗi
    R --> C : 429 AI_QUOTA_EXCEEDED { retryAt }
  else Còn quota
    G -> AI : generateContent
    AI --> G : { candidates: [{ headword, lemma, partOfSpeech,\nmeaningVi, cefr, topics, sentence }] }
    G --> S : candidates
    note right of G
      Một lần gọi cho cả tài liệu, đi qua cùng cơ chế
      của AI gateway như seq-02: tra AiCache,
      thử lại tối đa 3 lần đến khi đúng schema,
      ghi AiUsage. Không chia đoạn.
    end note
    S -> S : Bỏ ứng viên có sentence không nằm trong văn bản
    S -> S : Gộp theo (lemma, loại từ), tối đa 30 ứng viên
    S --> R : candidates[] (kèm startOffset, endOffset)
    R --> C : 200
    C -> C : Đánh dấu "Đã có" các ứng viên trùng\nvùng đã tô trong tài liệu này
    C --> U : Danh sách có checkbox
    U -> C : Chọn từ, "Lưu các từ đã chọn"
    C -> R : POST /api/v1/vocab/entries { entries: [ ... ] }
    R -> V : saveEntries
    V -> DB : Upsert VocabEntry + INSERT VocabContext (transaction)
    R --> C : 201 { entries }
  end
end
@enduml
