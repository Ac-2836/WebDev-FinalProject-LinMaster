skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #4A6FA5
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #4A6FA5
skinparam ActorBorderColor #3D4451
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #4A6FA5
skinparam ActivityDiamondBackgroundColor #FFF4E0
skinparam ActivityDiamondBorderColor #C08A2B
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #EEF4FB
skinparam StateBorderColor #4A6FA5
skinparam SequenceLifeLineBorderColor #8A94A6
skinparam SequenceParticipantBackgroundColor #E3ECF7
skinparam SequenceParticipantBorderColor #4A6FA5
