@startuml uc-01-auth
!include ../_style.iuml
title Use case phân rã — Tài khoản (auth)
left to right direction
actor "Khách" as Guest
actor "Người học" as Learner
rectangle "auth" {
  usecase "UC01 Đăng ký" as UC01
  usecase "UC02 Đăng nhập" as UC02
  usecase "UC03 Đăng xuất" as UC03
  usecase "UC04 Cập nhật hồ sơ" as UC04
  usecase "Đặt mục tiêu band" as UC04a
  usecase "UC05 Đổi ngôn ngữ giao diện" as UC05
  usecase "Kiểm tra dữ liệu nhập" as V
}
Guest --> UC01
Guest --> UC02
Guest --> UC05
Learner --> UC03
Learner --> UC04
Learner --> UC05
UC01 ..> V : <<include>>
UC04 ..> V : <<include>>
UC04 <.. UC04a : <<extend>>
note bottom of UC05
  Khách: lưu lựa chọn ở trình duyệt.
  Người học: lưu vào hồ sơ (User.locale).
end note
@enduml
