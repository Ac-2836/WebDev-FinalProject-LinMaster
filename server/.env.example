# Copy to server/.env and adjust. Only variable names and local values belong here, never real secrets.
NODE_ENV=development
PORT=4000
# Required, at least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# PostgreSQL from docker-compose.yml (local only). Production sets its own value on Render.
DATABASE_URL=postgresql://linmaster:linmaster@localhost:5432/linmaster_dev
# Separate database for tests, created by docker/postgres/init.
TEST_DATABASE_URL=postgresql://linmaster:linmaster@localhost:5432/linmaster_test

# Gemini (AI gateway). Get a key at Google AI Studio; leave empty to run without AI (tests always use a mock).
GEMINI_API_KEY=
# Optional; defaults to gemini-3.1-flash-lite (free tier; gemini-3.5-flash allows only 20 requests a day).
GEMINI_MODEL=

# Optional, for npm run db:seed: path to the sample Listening MP3 (L0), stored through the storage driver.
SEED_LISTENING_AUDIO=
