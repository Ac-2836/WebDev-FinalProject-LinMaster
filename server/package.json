{
  "name": "@linmaster/server",
  "version": "0.0.0",
  "private": true,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node build/index.js",
    "test": "vitest run",
    "postinstall": "prisma generate",
